---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const steps = [
  { number: "01", label: "Submit", description: "Fill out the form below with your details and a link to your live repo." },
  { number: "02", label: "Screen", description: "Chief of Staff agent reviews your submission for fit and impact." },
  { number: "03", label: "Demo", description: "Live demo at a guild meeting. Show the system, not the slides." },
  { number: "04", label: "Vote", description: "The room votes. Unanimous consent required." },
  { number: "05", label: "Install", description: "Collison install — a member personally onboards you." },
];
---

<Layout title="Apply — AI Tavern" description="Apply to join AI Tavern, a contribution-gated guild for AI builders.">
  <Nav />
  <main class="px-6 pt-32 pb-24">
    <div class="mx-auto max-w-3xl">
      <p class="mb-4 font-mono text-xs tracking-[0.3em] text-accent uppercase">Application</p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-text sm:text-4xl">Apply to AI Tavern</h1>
      <p class="mb-12 text-lg text-text-muted">
        There is no sign-up. There is no invite code. You apply with proof of work.
      </p>

      <!-- Process Steps -->
      <div class="mb-16 space-y-6">
        {steps.map((step) => (
          <div class="flex gap-6 border-l border-border pl-6">
            <span class="font-mono text-2xl font-bold text-accent/30">{step.number}</span>
            <div>
              <p class="mb-1 font-mono text-sm font-semibold tracking-wide text-text uppercase">{step.label}</p>
              <p class="text-sm leading-relaxed text-text-muted">{step.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Collaborator Invite Instructions -->
      <div class="mb-12 rounded border border-accent/30 bg-accent/5 p-6">
        <p class="mb-2 font-mono text-sm font-semibold tracking-wide text-accent uppercase">Before you submit</p>
        <p class="text-sm leading-relaxed text-text-muted">
          You must invite GitHub user
          <a href="https://github.com/jinglescore" class="text-accent hover:text-accent-light underline">jinglescore</a>
          as a <strong class="text-text">read-only collaborator</strong> on the repo you're submitting.
          Go to your repo's <strong class="text-text">Settings &rarr; Collaborators</strong> and add
          <code class="rounded bg-surface px-1.5 py-0.5 font-mono text-xs text-accent">jinglescore</code>.
          This allows the screening agent to review your code.
        </p>
      </div>

      <!-- Application Form -->
      <form id="apply-form" class="space-y-8" novalidate>
        <div>
          <label for="name" class="mb-2 block font-mono text-xs font-semibold tracking-wide text-text uppercase">
            Name / Handle <span class="text-accent">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            maxlength="100"
            placeholder="Your name or GitHub handle"
            class="w-full rounded border border-border bg-surface px-4 py-3 font-mono text-sm text-text placeholder:text-text-muted/50 focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <label for="ns-context" class="mb-2 block font-mono text-xs font-semibold tracking-wide text-text uppercase">
            Network School Context <span class="text-accent">*</span>
          </label>
          <p class="mb-2 text-xs text-text-muted">How are you connected to Network School? What's your role or background there?</p>
          <textarea
            id="ns-context"
            name="ns-context"
            required
            maxlength="1000"
            rows="3"
            placeholder="e.g., NS5 resident, building AI tools for education..."
            class="w-full rounded border border-border bg-surface px-4 py-3 font-mono text-sm text-text placeholder:text-text-muted/50 focus:border-accent focus:outline-none"
          ></textarea>
          <p class="mt-1 text-right font-mono text-xs text-text-muted"><span id="ns-context-count">0</span>/1000</p>
        </div>

        <div>
          <label for="system-description" class="mb-2 block font-mono text-xs font-semibold tracking-wide text-text uppercase">
            System Description <span class="text-accent">*</span>
          </label>
          <p class="mb-2 text-xs text-text-muted">What does your system do? What problem does it solve? Keep it concrete.</p>
          <textarea
            id="system-description"
            name="system-description"
            required
            maxlength="2000"
            rows="4"
            placeholder="e.g., An AI agent that monitors production deployments and auto-rolls back failures..."
            class="w-full rounded border border-border bg-surface px-4 py-3 font-mono text-sm text-text placeholder:text-text-muted/50 focus:border-accent focus:outline-none"
          ></textarea>
          <p class="mt-1 text-right font-mono text-xs text-text-muted"><span id="system-description-count">0</span>/2000</p>
        </div>

        <div>
          <label for="repo-url" class="mb-2 block font-mono text-xs font-semibold tracking-wide text-text uppercase">
            GitHub Repo URL <span class="text-accent">*</span>
          </label>
          <p class="mb-2 text-xs text-text-muted">Link to the repo with the system you're submitting. Must be a GitHub URL.</p>
          <input
            type="url"
            id="repo-url"
            name="repo-url"
            required
            placeholder="https://github.com/your-username/your-repo"
            class="w-full rounded border border-border bg-surface px-4 py-3 font-mono text-sm text-text placeholder:text-text-muted/50 focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <label for="justification" class="mb-2 block font-mono text-xs font-semibold tracking-wide text-text uppercase">
            10x-Everyone Justification <span class="text-accent">*</span>
          </label>
          <p class="mb-2 text-xs text-text-muted">How will your membership make every other member 10x better? Be specific.</p>
          <textarea
            id="justification"
            name="justification"
            required
            maxlength="2000"
            rows="4"
            placeholder="e.g., I can share my production RAG pipeline patterns, help members debug embeddings issues..."
            class="w-full rounded border border-border bg-surface px-4 py-3 font-mono text-sm text-text placeholder:text-text-muted/50 focus:border-accent focus:outline-none"
          ></textarea>
          <p class="mt-1 text-right font-mono text-xs text-text-muted"><span id="justification-count">0</span>/2000</p>
        </div>

        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="collaborator-confirm"
            name="collaborator-confirm"
            required
            class="mt-1 h-4 w-4 shrink-0 appearance-none rounded border border-border bg-surface checked:border-accent checked:bg-accent focus:outline-none"
          />
          <label for="collaborator-confirm" class="text-sm text-text-muted">
            I have invited <code class="rounded bg-surface px-1.5 py-0.5 font-mono text-xs text-accent">jinglescore</code>
            as a read-only collaborator on the repo above. <span class="text-accent">*</span>
          </label>
        </div>

        <div id="form-error" class="hidden rounded border border-red-500/30 bg-red-500/5 p-4 font-mono text-sm text-red-400"></div>

        <div class="pt-4">
          <button
            type="submit"
            class="inline-block w-full border border-accent bg-accent px-10 py-4 font-mono text-sm font-bold tracking-widest text-base transition-all hover:bg-accent-light uppercase sm:w-auto"
          >
            Submit Application
          </button>
          <p class="mt-4 font-mono text-xs text-text-muted">
            You'll be redirected to GitHub to create an issue with your application. A GitHub account is required.
          </p>
        </div>
      </form>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById('apply-form') as HTMLFormElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;

  // Character counters
  ['ns-context', 'system-description', 'justification'].forEach((id) => {
    const textarea = document.getElementById(id) as HTMLTextAreaElement;
    const counter = document.getElementById(`${id}-count`) as HTMLSpanElement;
    if (textarea && counter) {
      textarea.addEventListener('input', () => {
        counter.textContent = String(textarea.value.length);
      });
    }
  });

  function showError(message: string) {
    errorDiv.textContent = message;
    errorDiv.classList.remove('hidden');
    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function hideError() {
    errorDiv.classList.add('hidden');
  }

  function isGitHubUrl(url: string): boolean {
    try {
      const parsed = new URL(url);
      return parsed.hostname === 'github.com' || parsed.hostname === 'www.github.com';
    } catch {
      return false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    hideError();

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const nsContext = (document.getElementById('ns-context') as HTMLTextAreaElement).value.trim();
    const systemDescription = (document.getElementById('system-description') as HTMLTextAreaElement).value.trim();
    const repoUrl = (document.getElementById('repo-url') as HTMLInputElement).value.trim();
    const justification = (document.getElementById('justification') as HTMLTextAreaElement).value.trim();
    const collaboratorConfirm = (document.getElementById('collaborator-confirm') as HTMLInputElement).checked;

    // Validation
    if (!name || !nsContext || !systemDescription || !repoUrl || !justification) {
      showError('All fields are required. Please fill in every field before submitting.');
      return;
    }

    if (!isGitHubUrl(repoUrl)) {
      showError('Repo URL must be a valid GitHub URL (e.g., https://github.com/username/repo).');
      return;
    }

    if (!collaboratorConfirm) {
      showError('You must confirm that you have invited jinglescore as a collaborator on your repo.');
      return;
    }

    // Construct issue body
    const issueTitle = `Application: ${name}`;
    const issueBody = [
      `## Applicant`,
      `**Name / Handle:** ${name}`,
      ``,
      `## Network School Context`,
      nsContext,
      ``,
      `## System Description`,
      systemDescription,
      ``,
      `## GitHub Repo`,
      repoUrl,
      ``,
      `## 10x-Everyone Justification`,
      justification,
      ``,
      `## Collaborator Invite`,
      `- [x] I have invited \`jinglescore\` as a read-only collaborator on the repo above.`,
    ].join('\n');

    // Build GitHub issue URL
    const params = new URLSearchParams({
      title: issueTitle,
      body: issueBody,
      labels: 'application',
    });

    const issueUrl = `https://github.com/aitavern/aitavern.github.io/issues/new?${params.toString()}`;

    // Check URL length — GitHub has a practical limit of ~8192 chars
    if (issueUrl.length > 8000) {
      showError('Your application is too long for URL-based submission. Please shorten your responses and try again.');
      return;
    }

    window.open(issueUrl, '_blank');
  });
</script>
