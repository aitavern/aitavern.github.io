---
import members from "../config/members.json";
---

<section id="members" class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-5xl">
    <p class="mb-4 font-mono text-xs tracking-[0.3em] text-accent uppercase">Guild Members</p>
    <p class="mb-12 text-text-muted">Each arrived with a system. Each makes the others stronger.</p>

    {members.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((member) => (
          <div class="group border border-border bg-surface p-6 transition-colors hover:border-accent/40">
            <p class="mb-2 font-mono text-sm font-semibold tracking-wide text-text">{member.name}</p>
            <p class="mb-4 text-sm leading-relaxed text-text-muted line-clamp-3">{member.contribution}</p>
            <a
              href={member.repo}
              class="font-mono text-xs tracking-wider text-accent/70 transition-colors hover:text-accent uppercase"
              target="_blank"
              rel="noopener noreferrer"
            >
              View Repo &rarr;
            </a>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-text-muted border border-border bg-surface p-8 text-center">The guild is forming. First members incoming.</p>
    )}
  </div>
</section>
